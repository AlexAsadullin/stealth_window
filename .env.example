# Copy this file to .env and put your key in it (GigaChat project → "API settings" → authorization key).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Freemium allows 1 simultaneous request
GIGACHAT_MAX_CONCURRENCY=1
# Optional overrides:
# GIGACHAT_MODEL=GigaChat-3-Ultra
# GIGACHAT_STT_MODEL=GigaChat-2-Pro
# GIGACHAT_VISION_MODEL=GigaChat-2-Max
